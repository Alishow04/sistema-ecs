rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ecsUser() {
      return signedIn()
        && request.auth.token.email in [
          'alison@fiedler.com.br',
          'murilo@fiedler.com.br',
          'caua@fiedler.com.br'
        ];
    }

    function creatorMatches(data) {
      return
        (request.auth.token.email == 'alison@fiedler.com.br' && data.creatorCode == 'AK')
        || (request.auth.token.email == 'murilo@fiedler.com.br' && data.creatorCode == 'ML')
        || (request.auth.token.email == 'caua@fiedler.com.br' && data.creatorCode == 'CP');
    }

    function changedByMatches(data) {
      return
        (request.auth.token.email == 'alison@fiedler.com.br' && data.changedBy == 'AK')
        || (request.auth.token.email == 'murilo@fiedler.com.br' && data.changedBy == 'ML')
        || (request.auth.token.email == 'caua@fiedler.com.br' && data.changedBy == 'CP');
    }

    // Central de Orçamentos SPX, incluindo revisions/ e states/.
    match /spx_quotes/{document=**} {
      allow read, write: if signedIn();
    }

    // Sistema ECS.
    match /ecsRecords/{docId} {
      allow read: if ecsUser();

      allow create: if
        ecsUser()
        && request.resource.data.keys().hasAll([
          'ecsCode','sequence','year','creatorCode','creatorName',
          'creatorEmail','creatorUid',
          'client','ecsDate','cancelled','createdAt','searchTokens'
        ])
        && creatorMatches(request.resource.data)
        && request.resource.data.creatorEmail == request.auth.token.email
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.sequence is int
        && request.resource.data.sequence > 0
        && request.resource.data.year is int
        && request.resource.data.cancelled == false
        && request.resource.data.ecsCode is string
        && request.resource.data.client is string
        && docId == string(request.resource.data.year) + '-' + string(request.resource.data.sequence);

      allow update: if
        ecsUser()
        && request.resource.data.ecsCode == resource.data.ecsCode
        && request.resource.data.sequence == resource.data.sequence
        && request.resource.data.year == resource.data.year
        && request.resource.data.creatorCode == resource.data.creatorCode
        && request.resource.data.creatorName == resource.data.creatorName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('creatorEmail', '') == resource.data.get('creatorEmail', '')
        && request.resource.data.get('creatorUid', '') == resource.data.get('creatorUid', '');

      allow delete: if false;

      match /history/{entryId} {
        allow read: if ecsUser();

        allow create: if
          ecsUser()
          && request.resource.data.keys().hasAll([
            'field','oldValue','newValue','changedBy',
            'changedByEmail','changedByUid','changedAt'
          ])
          && changedByMatches(request.resource.data)
          && request.resource.data.changedByEmail == request.auth.token.email
          && request.resource.data.changedByUid == request.auth.uid;

        allow update, delete: if false;
      }
    }

    match /ecsCounters/{year} {
      allow read: if ecsUser();

      allow create: if
        ecsUser()
        && request.resource.data.currentSequence is int
        && request.resource.data.currentSequence >= 0;

      allow update: if
        ecsUser()
        && request.resource.data.currentSequence is int
        && request.resource.data.currentSequence == resource.data.currentSequence + 1;

      allow delete: if false;
    }

    match /settings/{name} {
      allow read, write: if ecsUser();
    }

    // Nenhuma outra coleção fica implicitamente aberta.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
