rules_version = '2';

// ATENÇÃO — leia antes de publicar:
// Este app ainda não usa Firebase Authentication (identificação é só
// localStorage, ver seção 5 da análise). Sem Auth, estas regras não
// impedem que alguém com as chaves públicas do Firebase escreva direto
// na API, fora do app. Elas garantem a INTEGRIDADE dos dados (formato,
// campos obrigatórios, sequência sempre crescente) mas não são controle
// de acesso real. Para isso, os próximos passos recomendados são:
//   1) Firebase App Check (bloqueia clientes que não sejam o seu app)
//   2) Restringir a rede (ex.: Firebase Hosting + regra de IP/VPN)
//   3) Login real (Firebase Auth) quando fizer sentido no roadmap
//
// Enquanto isso, este arquivo é a única barreira contra escrita malformada
// ou fora de ordem — trate-o como parte da "mecânica segura", não como
// segurança de acesso.

service cloud.firestore {
  match /databases/{database}/documents {

    match /ecsRecords/{docId} {
      allow read: if true;

      allow create: if
        request.resource.data.keys().hasAll([
          'ecsCode','sequence','year','creatorCode','creatorName',
          'client','ecsDate','cancelled','createdAt','searchTokens'
        ])
        && request.resource.data.sequence is int
        && request.resource.data.sequence > 0
        && request.resource.data.year is int
        && request.resource.data.cancelled == false
        && request.resource.data.ecsCode is string
        && request.resource.data.client is string
        && docId == string(request.resource.data.year) + '-' + string(request.resource.data.sequence);

      // Campos "de identidade" nunca podem mudar depois de criados.
      allow update: if
        request.resource.data.ecsCode == resource.data.ecsCode
        && request.resource.data.sequence == resource.data.sequence
        && request.resource.data.year == resource.data.year
        && request.resource.data.creatorCode == resource.data.creatorCode
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;

      match /history/{entryId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(['field','oldValue','newValue','changedBy','changedAt']);
        allow update, delete: if false;
      }
    }

    match /ecsCounters/{year} {
      allow read: if true;
      // Só permite avançar a sequência (nunca diminuir ou pular a validação da transação).
      allow create: if request.resource.data.currentSequence is int && request.resource.data.currentSequence >= 0;
      allow update: if request.resource.data.currentSequence is int
        && request.resource.data.currentSequence == resource.data.currentSequence + 1;
      allow delete: if false;
    }

    match /settings/{name} {
      // Listas de apoio (vendedores, filiais, produtos...) — leitura livre,
      // escrita liberada por enquanto (tela de Configurações ainda não existe
      // nesta v1). Revisar quando Configurações + Auth existirem.
      allow read: if true;
      allow write: if true;
    }
  }
}
